generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  fullname      String?
  username      String?        @unique
  email         String?        @unique
  password      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  image         String?
  role          String         @default("user")
  bio           String?
  orders        Order[]
  subscriptions Subscription[]
  blogs         Blog[]
  comments      Comment[]
  tickets       Ticket[]
  ticketMessages TicketMessage[]
  logs          SystemLog[]
  projects      Project[]
}

model Tier {
  id            String         @id @default(cuid())
  name          String
  priceMonthly  Float
  priceYearly   Float
  priceLifetime Float?
  features      String[]
  description   String
  isPopular     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  orders        Order[]
}

model Theme {
  id            String         @id @default(cuid())
  name          String
  url           String
  description   String?
  icon          String?
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  description  String?
  status       String   @default("active")
  discount     Float
  discountType String
  limit        Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model Order {
  id             String   @id @default(cuid())
  userId         String
  tierId         String?
  tierName       String?
  themeId        String?
  themeName      String?
  price          Float
  currency       String   @default("TRY")
  status         String
  paymentId      String?
  conversationId String   @unique
  couponCode     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  token          String?  @unique
  user           User     @relation(fields: [userId], references: [id])
  tier           Tier?    @relation(fields: [tierId], references: [id])
  siteUrl        String?
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  tierId     String
  themeId    String?
  status     String
  period     String
  startDate  DateTime @default(now())
  endDate    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tier       Tier     @relation(fields: [tierId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  theme      Theme?   @relation(fields: [themeId], references: [id])
  siteUrl    String?
  project    Project? @relation("SubscriptionToProject")
}

model Project {
  id              String   @id @default(cuid())
  userId          String
  subscriptionId  String?  @unique
  siteName        String
  siteDescription String?
  domain          String?
  logoUrl         String?
  themeConfig     Json?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id])
  subscription    Subscription? @relation("SubscriptionToProject", fields: [subscriptionId], references: [id])
  orders          Order[]
}

model Blog {
  id            String         @id @default(cuid())
  title         String
  content       String
  image         String?
  slug          String         @unique
  authorId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author        User           @relation(fields: [authorId], references: [id])
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  blogId    String
  userId    String
  createdAt DateTime @default(now())

  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  categoryId String?  // e.g. Billing, Technical, General
  priority  String
  status    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  TicketCategory? @relation(fields: [categoryId], references: [id])
  messages  TicketMessage[]
}

model TicketCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tickets   Ticket[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model GeneralSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Karinca App")
  siteDescription String?
  logoUrl         String?
  faviconUrl      String?
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model SEOSettings {
  id                String   @id @default(cuid())
  metaTitle         String?  @default("Karinca App")
  metaDescription   String?
  metaKeywords      String?
  ogImage           String?
  twitterHandle     String?
  googleAnalyticsId String?
  updatedAt         DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  userId    String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}