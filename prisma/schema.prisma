generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  fullname  String?
  username  String?  @unique
  email     String?  @unique
  password  String?
  image     String?
  role      String   @default("user")
  bio       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}